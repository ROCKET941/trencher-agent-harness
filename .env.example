TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_MS=5000
# Independent model/effort confidence floor (minimum 0.70); also controls worker/context advice.
# Uncertain model falls back WITHIN an accepted lane; uncertain effort never vetoes its model.
JEV_MIN_CONFIDENCE=0.70
# Native host versus configured external API lane confidence floor (minimum 0.70).
JEV_LANE_MIN_CONFIDENCE=0.70
# Compatibility only: implementation final review is mandatory regardless of this value.
JEV_REVIEW_THRESHOLD=0.70
# Strong parallel confidence floor (minimum 0.80), unless explicit disjoint workstreams are validated.
JEV_PARALLEL_THRESHOLD=0.80
# Required conservative upper bound charged for each reserved Jev request (all retries share one reservation).
HARNESS_JEV_CALL_COST_USD=
# Reconcile successful Jev calls to reported input usage; output is currently free.
HARNESS_JEV_INPUT_USD_PER_MILLION=0.042
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8788
HARNESS_MCP_TOKEN=
# Native GPT-6 Astra XHigh commander/final reviewer and Luna Max research use ChatGPT plan.
# No OpenAI API key is used by harness execution.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
# Optional alias for KIMI_API_KEY. This is the Kimi Open Platform key, not Kimi Code.
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai
# Legacy role overrides below are accepted but ignored by the fixed native policy.
# Use Jev or a capability-validated requestedRoute for an external worker.
HARNESS_SCOUT_MODEL=
HARNESS_SCOUT_PROVIDER=
HARNESS_SCOUT_EFFORT=
HARNESS_ENGINEER_MODEL=
HARNESS_ENGINEER_PROVIDER=
HARNESS_ENGINEER_EFFORT=
HARNESS_DEBUG_MODEL=
HARNESS_DEBUG_PROVIDER=
HARNESS_DEBUG_EFFORT=
HARNESS_REVIEW_MODEL=
HARNESS_REVIEW_PROVIDER=
HARNESS_REVIEW_EFFORT=
HARNESS_EXCEPTIONAL_MODEL=
HARNESS_EXCEPTIONAL_PROVIDER=
HARNESS_EXCEPTIONAL_EFFORT=
HARNESS_MAX_INPUT_TOKENS=12000
# Conservative preflight ceiling for one serialized provider request.
# Falls back to HARNESS_MAX_INPUT_TOKENS when unset.
HARNESS_MAX_ESTIMATED_INPUT_TOKENS=12000
HARNESS_MAX_OUTPUT_TOKENS=5000
HARNESS_MAX_DELEGATIONS=2
HARNESS_MAX_PARALLEL=3
# Two ordinary attempts plus one final attempt that requires explicit owner authorization and new causal evidence.
HARNESS_MAX_ATTEMPTS=3
HARNESS_TASK_COST_USD=1
HARNESS_DAILY_COST_USD=5
HARNESS_PROVIDER_TIMEOUT_MS=30000
# Required server-owner gate for Jev and external xAI/DeepSeek/Kimi generation.
HARNESS_ENABLE_PAID_EXECUTION=false
# Legacy compatibility setting. API commander mode now fails closed; use the native host commander.
HARNESS_ENABLE_API_COMMANDER=false
# Optional persistent ledger location. Omit to use .state/accounting.json in the service working directory.
HARNESS_STATE_FILE=
